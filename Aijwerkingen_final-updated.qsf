        "QuestionID": "QID31",
        "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function () {\n  var origins = [\"https://aisafetywatch.com\", \"https://internal.aisafetywatch.com\"];\n  origins.forEach(function (origin) {\n    try {\n      window.parent.postMessage(\n        { sender: \"aijwerkingen-survey\", event: \"completed\" },\n        origin\n      );\n    } catch (e) {}\n  });\n});\n"
      }
