    {
      "SurveyID": "SV_eA4y9ucLih6un8a",
      "Element": "SQ",
      "PrimaryAttribute": "QID27",
      "SecondaryAttribute": "Kind of AI-related experience",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "What kind of AI-related experience ${e://Field/beq} reporting? (Select all that apply)",
        "DataExportTag": "Q_aitype",
        "QuestionType": "MC",
        "Selector": "MAVR",
        "SubSelector": "TX",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "Kind of AI-related experience",
        "Choices": {
          "1": {
            "Display": "Direct AI conversations (e.g., AI chatbots, companion AI, dating AI)"
          },
          "2": {
            "Display": "Deepfakes &amp; content (e.g., fake news, unauthorised AI use of personal images or video)"
          },
          "3": {
            "Display": "Social-media algorithms (e.g., feed recommendations)"
          },
          "4": {
            "Display": "Gaming &amp; virtual worlds (e.g., absorptive environments)"
          },
          "5": {
            "Display": "Surveillance &amp; tracking (e.g., facial recognition, AI-facilitated coercive control)"
          },
          "6": {
            "Display": "AI decision-making (e.g., health care, insurance)"
          },
          "7": {
            "Display": "Work environment (e.g., employee monitoring)"
          },
          "8": {
            "Display": "Other (please specify)",
            "TextEntry": "true"
          }
        },
        "ChoiceOrder": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ],
        "Validation": {
          "Settings": {
            "ForceResponse": "ON",
            "ForceResponseType": "ON",
            "Type": "MinChoices",
            "MinChoices": "1"
          }
        },
        "Language": [],
        "NextChoiceId": 9,
        "NextAnswerId": 1,
        "QuestionID": "QID27"
      }
