# .env.example - documents required environment variables. Never put real values here.
# Copy to .env.local for local development; set the same names in each deploy environment's secrets.

# Public site origin, must match src/site.config.ts canonicalUrl (ADR-008).
NEXT_PUBLIC_SITE_URL=https://aijwerkingen.github.io

# Survey backend selector: "qualtrics" (Mode A) | "native" (Mode B, Phase 3).
SURVEY_PROVIDER=qualtrics

# Mode A (Qualtrics) - see qualtrics-integration.md and P0-2 (confirm EU datacenter region).
# The survey URL is now a SERVER-SIDE Pages env var (never NEXT_PUBLIC_, so it is
# never bundled into the static site). Set QUALTRICS_SURVEY_URL on the Cloudflare
# project that serves the internal/staging site; the /report edge gate
# (functions/api/report-access.js) returns it only after the shared password
# (INTERNAL_PASSWORD) is verified. See docs/INTERNAL_AUTH_PLAN.md.
QUALTRICS_SURVEY_URL=https://your-org.qualtrics.com/jfe/form/SV_xxxxxxxxxxxx
INTERNAL_PASSWORD=

# Mode B (self-hosted, Phase 3 / ADR-009) - Docker Postgres, standard connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/aijwerkingen
