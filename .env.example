# .env.example - documents required environment variables. Never put real values here.
# Copy to .env.local for local development; set the same names in each deploy environment's secrets.

# Public site origin, must match src/site.config.ts canonicalUrl (ADR-008).
NEXT_PUBLIC_SITE_URL=https://aiimpactregistry.org

# Survey backend selector: "qualtrics" (Mode A) | "native" (Mode B, Phase 3).
SURVEY_PROVIDER=qualtrics

# Mode A (Qualtrics) - see qualtrics-integration.md and P0-2 (confirm EU datacenter region).
# The survey URL is now a SERVER-SIDE Pages env var (never NEXT_PUBLIC_, so it is
# never bundled into the static site). Set QUALTRICS_SURVEY_URL on the Cloudflare
# project that serves the internal/staging site; the /report edge gate
# (functions/api/report-access.js) returns it only after the shared password
# (INTERNAL_PASSWORD) is verified. See docs/INTERNAL_AUTH_PLAN.md.
# Current value: the UvA EU (Frankfurt / fra1) instance below. Set the same value
# as an encrypted secret on the Cloudflare project - do not rely on this file.
QUALTRICS_SURVEY_URL=https://uva.fra1.qualtrics.com/jfe/form/SV_1zdQGq7PaFsv2Jg
INTERNAL_PASSWORD=
# BUILD-TIME flag (not a secret): "1" turns the /report gate on - the page fetches
# /api/report-access and offers the password form. Set ONLY by the staging deploy
# (.github/workflows/deploy.yml). Leave unset for production, where /report stays
# the plain "launches soon" placeholder. Never set INTERNAL_PASSWORD or
# QUALTRICS_SURVEY_URL on the production Cloudflare project.
NEXT_PUBLIC_REPORT_GATE=

# BUILD-TIME flag (not a secret): "1" renders the brand preview panel (name,
# colour-way, font, appearance) and honours its localStorage override. Set ONLY
# by the staging deploy (.github/workflows/deploy.yml). Leave unset for
# production, where the panel is compiled out and the site.config.ts defaults
# (dark, Maven Pro + Open Sans) are the only brand on record.
NEXT_PUBLIC_BRAND_PANEL=

# Mode B (self-hosted, Phase 3 / ADR-009) - Docker Postgres, standard connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/aijwerkingen
