# .env.example - documents required environment variables. Never put real values here.
# Copy to .env.local for local development; set the same names in each deploy environment's secrets.

# Public site origin, must match src/site.config.ts canonicalUrl (ADR-008).
NEXT_PUBLIC_SITE_URL=https://aiimpactregistry.org

# Survey backend selector: "qualtrics" (Mode A) | "native" (Mode B, Phase 3).
SURVEY_PROVIDER=qualtrics

# Mode A (Qualtrics) - see qualtrics-integration.md and P0-2 (confirm EU datacenter region).
# The survey URL is a SERVER-SIDE Pages env var (never NEXT_PUBLIC_, so it is never
# bundled into the static site). functions/api/report-access.js returns it only after
# the shared password (INTERNAL_PASSWORD) is verified, or to everyone when the
# temporary pilot switch DISABLE_PRODUCTION_GATE is on. See docs/INTERNAL_AUTH_PLAN.md.
#
# DELIBERATELY NO VALUE HERE. The live link is not tracked in this repo: it lives only
# in the Cloudflare Pages project env, and it CHANGES every time the survey is
# re-created in Qualtrics. Read it from the project, or from a running site:
#   curl https://<host>/api/report-access        # {"url":"..."} once unlocked
# Survey CONTENT versions live in survey-doc/<YYYY-MM-DD>/ (QSF + readable export).
# Do not paste a survey URL into this file - a stale copy here is exactly how a retired
# form once got wired into production.
QUALTRICS_SURVEY_URL=
INTERNAL_PASSWORD=
# BUILD-TIME flag (not a secret): "1" turns the /report gate on - the page fetches
# /api/report-access and offers the password form. Set ONLY by the staging deploy
# (.github/workflows/deploy.yml). Leave unset for production, where /report shows the
# plain "launches soon" placeholder unless the pilot switch below is on.
NEXT_PUBLIC_REPORT_GATE=

# TEMPORARY pilot switch (Pages environment variable, NOT NEXT_PUBLIC_ and not a
# build flag): "1" makes functions/api/report-access.js hand the survey URL to
# anyone, so /report is public with no password while the pilot runs. Set it on
# the PRODUCTION project (Cloudflare -> aisafetywatch -> Settings -> Variables and
# Secrets -> Production) together with QUALTRICS_SURVEY_URL; delete it to restore
# the gate. It lives server-side on purpose - the survey URL must never reach the
# static bundle, or restoring the gate would be cosmetic.
DISABLE_PRODUCTION_GATE=

# BUILD-TIME flag (not a secret): "1" renders the brand preview panel (name,
# colour-way, font, appearance) and honours its localStorage override. Set ONLY
# by the staging deploy (.github/workflows/deploy.yml). Leave unset for
# production, where the panel is compiled out and the site.config.ts defaults
# (dark, Maven Pro + Open Sans) are the only brand on record.
NEXT_PUBLIC_BRAND_PANEL=

# Mode B (self-hosted, Phase 3 / ADR-009) - Docker Postgres, standard connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/aijwerkingen
