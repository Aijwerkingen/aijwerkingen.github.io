{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amc-larebish.example/survey.schema.json",
  "title": "AMC-Larebish survey configuration",
  "description": "Validates config-driven survey definitions for Mode B (self-hosted). Used at build time (CI gate) and runtime.",
  "type": "object",
  "required": ["version", "locale_default", "metadata", "sections"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Semver; stored as survey_version on each submission. Bump on every change.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "locale_default": { "type": "string", "minLength": 2 },
    "locales": { "type": "array", "items": { "type": "string", "minLength": 2 }, "uniqueItems": true },
    "metadata": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "estimated_minutes": { "type": "integer", "minimum": 1 }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "i18n_key": { "type": "string" },
        "record_consent_version": { "type": "boolean" }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["id", "title", "questions"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } }
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "type", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "type": {
          "type": "string",
          "enum": [
            "short_text", "long_text", "single_choice", "multi_choice",
            "dropdown", "number", "date", "boolean", "scale", "email",
            "section_break", "info"
          ]
        },
        "label": { "type": "string" },
        "help": { "type": "string" },
        "required": { "type": "boolean", "default": false },
        "pii": {
          "type": "boolean",
          "default": false,
          "description": "Marks a field as personal data; drives encryption + retention handling."
        },
        "i18n_key": { "type": "string" },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_length": { "type": "integer", "minimum": 1 },
            "min_length": { "type": "integer", "minimum": 0 },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "pattern": { "type": "string" }
          }
        },
        "options": {
          "type": "array",
          "description": "Required for single_choice, multi_choice, dropdown.",
          "items": {
            "type": "object",
            "required": ["value"],
            "additionalProperties": false,
            "properties": {
              "value": { "type": "string" },
              "i18n_key": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        },
        "scale": {
          "type": "object",
          "required": ["min", "max"],
          "additionalProperties": false,
          "properties": {
            "min": { "type": "integer" },
            "max": { "type": "integer" },
            "min_label_i18n": { "type": "string" },
            "max_label_i18n": { "type": "string" }
          }
        },
        "conditional": {
          "type": "object",
          "description": "Show/hide this question based on another answer.",
          "required": ["when"],
          "additionalProperties": false,
          "properties": {
            "when": { "type": "string", "description": "Referenced question id." },
            "equals": {},
            "in": { "type": "array" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["single_choice", "multi_choice", "dropdown"] } } },
          "then": { "required": ["options"] }
        },
        {
          "if": { "properties": { "type": { "const": "scale" } } },
          "then": { "required": ["scale"] }
        }
      ]
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Stable snake_case identifier; do not rename after data is collected."
    }
  }
}
